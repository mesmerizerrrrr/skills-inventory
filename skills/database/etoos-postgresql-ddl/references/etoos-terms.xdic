  <term name="문자열" description="데이터로 다루는 일련의 문자. 숫자를 포함하는 것이어도 계산하는 숫자로서가 아니라 코드의 일부로 쓰는 것이면 문자열이라 할 수 있다." physicalName="strng" physicalDescription="STRING" tag="//@tag.0"/>
  <term name="문자형" description="문자의 꼴." physicalName="typechar" physicalDescription="TYPE CHARACTER" tag="//@tag.0"/>
  <term name="문자형키" description="문자형 식별자를 구분하는 KEY" physicalName="charkey" physicalDescription="CHARACTER KEY" tag="//@tag.0"/>
  <term name="문장" description="생각이나 감정을 말과 글로 표현할 때 완결된 내용을 나타내는 최소의 단위." physicalName="sentn" physicalDescription="SENTENCE" tag="//@tag.0"/>
  <term name="문제" description="해답을 요구하는 물음" physicalName="qst" physicalDescription="QUESTION" tag="//@tag.0"/>
  <term name="문제1" description="해답을 요구하는 물음" physicalName="qst1" physicalDescription="QUESTION 1" tag="//@tag.0"/>
  <term name="문제2" description="해답을 요구하는 물음" physicalName="qst2" physicalDescription="QUESTION 2" tag="//@tag.0"/>
  <term name="문제3" description="해답을 요구하는 물음" physicalName="qst3" physicalDescription="QUESTION 3" tag="//@tag.0"/>
  <term name="문제4" description="해답을 요구하는 물음" physicalName="qst4" physicalDescription="QUESTION 4" tag="//@tag.0"/>
  <term name="문제5" description="해답을 요구하는 물음" physicalName="qst5" physicalDescription="QUESTION 5" tag="//@tag.0"/>
  <term name="문제6" description="해답을 요구하는 물음" physicalName="qst6" physicalDescription="QUESTION 6" tag="//@tag.0"/>
  <term name="문제지" description="문제가 수록되어 있는 종이" physicalName="examppr" physicalDescription="EXAMINATION PAPER" tag="//@tag.0"/>
  <term name="문항" description="문제의 항목." physicalName="qustn" physicalDescription="QUESTION" tag="//@tag.0"/>
  <term name="문항별" description="각각의 문제항목" physicalName="byqustn" physicalDescription="CLASSIFIED BY QUESTION" tag="//@tag.0"/>
  <term name="물류" description="물적유통을 줄인 말로 생산자로부터 소비자까 지의 물(物)의 흐름을 가리킨다. [법률정의] (화물유통촉진법) 재화가 공급자로부터 수요자에게 전달될 때까지 이루어지는 운송·보관·하역·포장과 이에 필요한 정보통신등의 경제활동." physicalName="logist" physicalDescription="LOGISTICS" tag="//@tag.0"/>
  <term name="미경과" description="경과하지 않음" physicalName="noelps" physicalDescription="NOT YET ELAPSE" tag="//@tag.0"/>
  <term name="미니" description="소형(小型)임을 이르는 말." physicalName="mini" physicalDescription="MINI" tag="//@tag.0"/>
  <term name="미답변" description="물음에 대하여 밝혀 대답하지 않음" physicalName="noansr" physicalDescription="NOT YET ANSWER" tag="//@tag.0"/>
  <term name="미디어" description="어떤 작용을 한쪽에서 다른 쪽으로 전달하는 역할을 하는 것." physicalName="media" physicalDescription="MEDIA" tag="//@tag.0"/>
  <term name="미디어폴" description="모든 형태의 표지판 기능을 한 곳에 모아 디지털 형식을 구현하여 도로변에 설치한 시설물" physicalName="midapl" physicalDescription="MEDIAPOLE" tag="//@tag.0"/>
  <term name="미리보기" description="어떤 일이 생기기 전에. 또는 어떤 일을 하기에 앞서 보는 것" physicalName="lkahd" physicalDescription="LOOK AHEAD" tag="//@tag.0"/>
  <term name="미만" description="정한 수효나 정도에 차지 못함. 또는 그런 상태. 기준이 수량으로 제시될 경우에는, 그 수량이 범위에 포함되지 않으면서 그 아래인 경우를 가리킨다." physicalName="und" physicalDescription="UNDER" tag="//@tag.0"/>
  <term name="미반영" description="반영을 하지 않는다는 뜻으로, 외부의 영향과는 상관없이 아무 현상도 나타내지 않는 것을 말한다." physicalName="noreflt" physicalDescription="NOT YET REFLECTION" tag="//@tag.0"/>
  <term name="미선택" description="선택하지 않음" physicalName="nosel" physicalDescription="NOT YET SELECTION" tag="//@tag.0"/>
  <term name="미세" description="분간하기 어려울 정도로 아주 작음." physicalName="tiny" physicalDescription="TINY" tag="//@tag.0"/>
  <term name="미션" description="목표나 목적." physicalName="mison" physicalDescription="MISSION" tag="//@tag.0"/>
  <term name="미션1" description="목표나 목적." physicalName="mison1" physicalDescription="MISSION 1" tag="//@tag.0"/>
  <term name="미션2" description="목표나 목적." physicalName="mison2" physicalDescription="MISSION 2" tag="//@tag.0"/>
  <term name="미션3" description="목표나 목적." physicalName="mison3" physicalDescription="MISSION 3" tag="//@tag.0"/>
  <term name="미션4" description="목표나 목적." physicalName="mison4" physicalDescription="MISSION 4" tag="//@tag.0"/>
  <term name="미술" description="공간 및 시각의 미를 표현하는 예술" physicalName="art" physicalDescription="ART" tag="//@tag.0"/>
  <term name="미응답" description="부름이나 물음에 응하지 않음" physicalName="norespn" physicalDescription="NOT YET RESPONSE" tag="//@tag.0"/>
  <term name="바로잡기" description="굽거나 비뚤어진 것을 곧게 하다." physicalName="retfictn" physicalDescription="RECTIFICATION" tag="//@tag.0"/>
  <term name="바이너리" description="0과 1로 표시하는 번호 지정 체계." physicalName="bin" physicalDescription="BINARY" tag="//@tag.0"/>
  <term name="바코드" description="상품의 포장이나 꼬리표에 표시된 검고 흰 줄무늬. 제조 회사, 제품의 가격, 종류 따위의 정보를 나타낸 것으로, 광학적으로 판독되어 컴퓨터에 입력된다." physicalName="barcd" physicalDescription="BAR CODE" tag="//@tag.0"/>
  <term name="반" description="일정한 목적을 위하여 조직한 사람들의 작은 집단." physicalName="cls" physicalDescription="CLASS" tag="//@tag.0"/>
  <term name="반기" description="한 해의 절반." physicalName="hftm" physicalDescription="HALF TERM" tag="//@tag.0"/>
  <term name="반대" description="어떤 행동이나 견해, 제안 따위에 따르지 아니하고 맞서 거스름." physicalName="opps" physicalDescription="OPPOSITION" tag="//@tag.0"/>
  <term name="반려" description="주로 윗사람이나 상급 기관에 제출한 문서를 처리하지 않고 되돌려줌." physicalName="retn" physicalDescription="RETURN" tag="//@tag.0"/>
  <term name="반려자" description="짝이 되는 사람." physicalName="patnr" physicalDescription="PARTNER" tag="//@tag.0"/>
  <term name="반복" description="같은 일을 되풀이함." physicalName="rept" physicalDescription="REPETITION" tag="//@tag.0"/>
  <term name="반송" description="도로 돌려보냄" physicalName="retn" physicalDescription="RETURN" tag="//@tag.0"/>
  <term name="반영" description="다른 것에 영향을 받아 어떤 현상이 나타남. 또는 어떤 현상을 나타냄." physicalName="rflctn" physicalDescription="REFLECTION" tag="//@tag.0"/>
  <term name="반응" description="자극에 대응하여 어떤 현상이 일어남. 또는 그 현상." physicalName="resp" physicalDescription="RESPONSE" tag="//@tag.0"/>
  <term name="반출" description="운반하여 냄." physicalName="tkout" physicalDescription="TAKE SOMETHING OUT OF" tag="//@tag.0"/>
  <term name="반품" description="일단 사들인 물품을 되돌려보냄. 또는 그 물품." physicalName="tkbak" physicalDescription="TAKE SOMETHING BACK" tag="//@tag.0"/>
  <term name="반환" description="빌리거나 차지했던 것을 되돌려 줌." physicalName="retn" physicalDescription="RETURN" tag="//@tag.0"/>
  <term name="받기" description="다른 사람이 주거나 보내오는 물건 따위를 가지다." physicalName="get" physicalDescription="GET" tag="//@tag.0"/>
  <term name="발견" description="미처 찾아내지 못하였거나 아직 알려지지 아니한 사물이나 현상, 사실 따위를 찾아냄." physicalName="discvry" physicalDescription="DISCOVERY" tag="//@tag.0"/>
  <term name="발급" description="증명서 따위를 발행하여 줌." physicalName="issue" physicalDescription="ISSUE" tag="//@tag.0"/>
  <term name="발도장" description="누군가에게 내가 다녀간 흔적(방명록)을 남기다." physicalName="fotprt" physicalDescription="FOOTPRINT" tag="//@tag.0"/>
  <term name="발생" description="어떤 일이나 사물이 생겨남." physicalName="occur" physicalDescription="OCCURRENCE" tag="//@tag.0"/>
  <term name="발생2" description="어떤 일이나 사물이 생겨남." physicalName="occur2" physicalDescription="OCCURRENCE 2" tag="//@tag.0"/>
  <term name="발송" description="물건, 편지, 서류 따위를 우편이나 운송 수단을 이용하여 보냄." physicalName="send" physicalDescription="SEND" tag="//@tag.0"/>
  <term name="발송자" description="물건, 편지, 서류 따위를 부치거나 보낸 사람" physicalName="sender" physicalDescription="SENDER" tag="//@tag.0"/>
  <term name="발신" description="소식이나 우편 또는 전신을 보냄. 또는 그런 것." physicalName="send" physicalDescription="SEND" tag="//@tag.0"/>
  <term name="발신자" description="소식이나 우편 또는 전신 따위를 보낸 사람" physicalName="sender" physicalDescription="SENDER" tag="//@tag.0"/>
  <term name="발전" description="더 낫고 좋은 상태나 더 높은 단계로 나아감. 일이 어떤 방향으로 전개됨." physicalName="devlpmt" physicalDescription="DEVELOPMENT" tag="//@tag.0"/>
  <term name="발주" description="물건을 보내 달라고 주문함." physicalName="ord" physicalDescription="ORDER" tag="//@tag.0"/>
  <term name="발주자" description="물건 따위를 주문하는 사람." physicalName="ordpsn" physicalDescription="ORDERING PERSON" tag="//@tag.0"/>
  <term name="발표" description="어떤 사실이나 결과, 작품 따위를 세상에 널리 드러내어 알림." physicalName="anocmt" physicalDescription="ANNOUNCEMENT" tag="//@tag.0"/>
  <term name="발행" description="출판물이나 인쇄물을 찍어서 세상에 펴냄. [법률정의] (컴퓨터프로그램보호법) 공중의 수요에 응하기 위하여 프로그램을 복제·배포하는 행위." physicalName="publct" physicalDescription="PUBLICATION" tag="//@tag.0"/>
  <term name="발행인" description="출판물을 발행하는 사람." physicalName="publer" physicalDescription="PUBLISHER" tag="//@tag.0"/>
  <term name="밝기" description="빛이나 불의 밝은 정도." physicalName="britn" physicalDescription="BRIGHTNESS" tag="//@tag.0"/>
  <term name="방문" description="어떤 사람이나 장소를 찾아가서 만나거나 봄." physicalName="visit" physicalDescription="VISIT" tag="//@tag.0"/>
  <term name="방문자" description="어떤 사람이나 장소를 찾아오는 사람." physicalName="visitor" physicalDescription="VISITOR" tag="//@tag.0"/>
  <term name="방법" description="어떤 일을 해 나가거나 목적을 이루기 위하여 취하는 수단이나 방식." physicalName="method" physicalDescription="METHOD" tag="//@tag.0"/>
  <term name="방식" description="어떤 일정한 형식이나 방법." physicalName="method" physicalDescription="METHOD" tag="//@tag.0"/>
  <term name="방학" description="일정 기간 동안 수업을 쉬는 일. 또는 그 기간. 주로 학교에서 학기나 학년이 끝난 뒤 또는 더위, 추위가 심할 때 실시한다." physicalName="vactn" physicalDescription="VACATION" tag="//@tag.0"/>
  <term name="배경" description="사건이나 환경을 둘러싼 주위의 정경." physicalName="bkgrud" physicalDescription="BACKGROUND" tag="//@tag.0"/>
  <term name="배너" description="인터넷 홈페이지에 띠 모양으로 부착하는 광고를 말한다." physicalName="bner" physicalDescription="BANNER" tag="//@tag.0"/>
  <term name="배너1" description="인터넷 홈페이지에 띠 모양으로 부착하는 광고를 말한다." physicalName="bner1" physicalDescription="BANNER 1" tag="//@tag.0"/>
  <term name="배너2" description="인터넷 홈페이지에 띠 모양으로 부착하는 광고를 말한다." physicalName="bner2" physicalDescription="BANNER 2" tag="//@tag.0"/>
  <term name="배달" description="물건을 가져다가 몫몫으로 나누어 돌림." physicalName="deliv" physicalDescription="DELIVERY" tag="//@tag.0"/>
  <term name="배분" description="몫몫이 별러 나눔." physicalName="dtbutn" physicalDescription="DISTRIBUTION" tag="//@tag.0"/>
  <term name="배속" description="컴퓨터에서, 전송 속도의 단위  초당 150KB의 데이터를 읽어 낼 수 있는 음악 시디(CD)의 재생 속도를 기준으로 하여 몇 배의 전송 속도를 갖고 있느냐로 표현한다." physicalName="tmspd" physicalDescription="TIMES SPEED" tag="//@tag.0"/>
  <term name="배송" description="물자를 여러 곳에 나누어 보내 줌." physicalName="deliv" physicalDescription="DELIVERY" tag="//@tag.0"/>
  <term name="배송비" description="서류, 물건 등을 배달해 주는 서비스에 대한 요금" physicalName="delivfee" physicalDescription="DELIVERY FEE" tag="//@tag.0"/>
  <term name="배송지" description="물품을 다른 곳으로 보낼 때 그 물품을 받는 장소." physicalName="destn" physicalDescription="DESTINATION" tag="//@tag.0"/>
  <term name="배점" description="점수를 각각 나누어 배정함. 또는 그렇게 하여 정해진 점수." physicalName="alot" physicalDescription="ALLOT" tag="//@tag.0"/>
  <term name="배정" description="몫을 나누어 정함." physicalName="aloct" physicalDescription="ALLOCATION" tag="//@tag.0"/>
  <term name="배치" description="처리할 데이터를 일정 기간 또는 일정량을 기준으로 묶어서 한꺼번에 처리하는 방식" physicalName="bat" physicalDescription="BATCH" tag="//@tag.0"/>
  <term name="배치표" description="사람이나 물자 따위를 일정한 자리에 알맞게 나누어서 형식과 순서에 따라 보기 쉽게 나타낸것" physicalName="alotb" physicalDescription="ALLOTMENT TABLE" tag="//@tag.0"/>
  <term name="배터리" description="건전지, 혹은 기계를 작동시키기 위한 연료를 일컫는 말." physicalName="batry" physicalDescription="BATTERY" tag="//@tag.0"/>
  <term name="백분위" description="특정 집단의 점수 분포에서 한 개인의 상대적 위치를 나타내는 유도 점수(誘導點數)" physicalName="pctrk" physicalDescription="PERCENTILE RANK" tag="//@tag.0"/>
  <term name="백분율" description="전체 수량을 100으로 하여 그것에 대해 가지는 비율." physicalName="pctg" physicalDescription="PERCENTAGE" tag="//@tag.0"/>
  <term name="백브" description="백브라더스 : 백호, 백인덕 형제 선생님" physicalName="bbr" physicalDescription="BAEK BROTHERS" tag="//@tag.0"/>
  <term name="백오더" description="재고가 없어서 처리하지 못한 주문. 밀려 있는 주문량을 이른다." physicalName="bkord" physicalDescription="BACK ORDER" tag="//@tag.0"/>
  <term name="버전" description="어떤 문서 등이 생성되거나 수정될 때 메겨지는 번호. &lt;컴퓨터> 어떤 소프트웨어가 몇 번 개정되었는지를 나타내는 번호. 보통 소프트웨어가 처음 출시될 때 버전이 1.0이고, 추후 기존의 기능이 보완되거나 새로운 기능이 추가될 때 버전을 올린다." physicalName="ver" physicalDescription="VERSION" tag="//@tag.0"/>
  <term name="버튼" description="전기  전기 장치에 전류를 끊거나 이어 주거나 하며 기기를 조작하는 장치." physicalName="butn" physicalDescription="BUTTON" tag="//@tag.0"/>
  <term name="번외편" description="계획에 들어 있지 않은 형식이나 내용, 성질 따위가 다른 글을 구별하여 나타내는 말." physicalName="besid" physicalDescription="BESIDES PIECE" tag="//@tag.0"/>
  <term name="번지" description="토지를 조각조각 나누어서 매겨 놓은 땅의 번호." physicalName="lotno" physicalDescription="LOT NUMBER" tag="//@tag.0"/>
  <term name="번호" description="차례를 나타내거나 식별하기 위해 붙이는 숫자." physicalName="no" physicalDescription="NUMBER" tag="//@tag.0"/>
  <term name="번호별" description="번호에 따른 구별." physicalName="byno" physicalDescription="CLASSIFIED BY NUMBER" tag="//@tag.0"/>
  <term name="범위" description="테두리가 정하여진 구역. 어떤 것이 미치는 한계." physicalName="bnd" physicalDescription="BOUNDS" tag="//@tag.0"/>
